OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
OPENAI_MODEL=agnes-2.0-flash
COLLECTION_NAME=documind_collection

# ---- 中期增强（功能增强）开关 ----
# 混合检索：BM25 词法 + 向量语义融合（RRF）
HYBRID_SEARCH=false
HYBRID_ALPHA=0.5
# Reranker 重排序：默认零依赖词法重排；可选 cross_encoder（需 sentence-transformers）
RERANK_ENABLED=false
RERANK_TOP_N=12
RERANK_TYPE=auto
# 对话记忆：token 预算与 LLM 摘要压缩
MEMORY_MAX_TOKENS=2000
MEMORY_USE_SUMMARY=true
